{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estatetrace.local/schemas/policy_pack.schema.json",
  "title": "EstateTrace Policy Pack",
  "description": "schema_version 1. Fields added for evaluator v2 (targets, not_evaluated, mode, lane, status, the extended operator set) are optional, so older packs stay valid.",
  "type": "object",
  "required": ["schema_version", "id", "name", "revision", "controls"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "revision": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "controls": {
      "type": "array",
      "items": { "$ref": "#/$defs/control" }
    },
    "example_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/example_case" }
    }
  },
  "$defs": {
    "environment": {
      "description": "prod, nonprod, dev, sandbox or unknown. Case, spaces, hyphens and underscores are ignored; production, non-prod, development and sbx are accepted. all/any means every environment.",
      "type": "string",
      "minLength": 1
    },
    "control": {
      "type": "object",
      "required": ["id", "source", "owner", "severity"],
      "anyOf": [
        { "required": ["check"] },
        { "required": ["targets"] },
        { "required": ["not_evaluated"] },
        { "required": ["manual"], "properties": { "manual": { "const": true } } }
      ],
      "not": { "required": ["check", "targets"] },
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["document", "revision", "clause"],
          "properties": {
            "document": { "type": "string" },
            "revision": { "type": "string" },
            "clause": { "type": "string" }
          }
        },
        "owner": { "type": "string", "minLength": 1 },
        "effective_from": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "applies_to": { "$ref": "#/$defs/applies_to" },
        "check": {
          "description": "Legacy single check: evaluated on every resource type.",
          "$ref": "#/$defs/check"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        },
        "not_evaluated": { "$ref": "#/$defs/not_evaluated" },
        "mode": { "enum": ["scored", "flag"] },
        "lane": { "enum": ["security", "hygiene"] },
        "status": { "enum": ["provisional", "verified"] },
        "azure_remediation": { "type": "object" },
        "evidence_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "grace_period_hours": { "type": "integer", "minimum": 0 },
        "manual": {
          "description": "Legacy: same as not_evaluated with category outside_azure.",
          "type": "boolean"
        },
        "fix": { "type": "string" },
        "judges": { "type": "string" }
      }
    },
    "applies_to": {
      "type": "object",
      "properties": {
        "environment": {
          "description": "Legacy single environment (or list).",
          "oneOf": [
            { "$ref": "#/$defs/environment" },
            { "type": "array", "items": { "$ref": "#/$defs/environment" } }
          ]
        },
        "environments": {
          "type": "array",
          "items": { "$ref": "#/$defs/environment" }
        },
        "capability": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["resource_kind"], "not": { "required": ["resource_type"] } },
        { "required": ["resource_type"], "not": { "required": ["resource_kind"] } }
      ],
      "properties": {
        "resource_kind": {
          "description": "A name or alias from kits/policy-authoring/resource_kinds.yaml.",
          "type": "string",
          "minLength": 1
        },
        "resource_type": {
          "description": "An ARM type (case-insensitive), or * for every type.",
          "type": "string",
          "minLength": 1
        },
        "filter": { "$ref": "#/$defs/leaf" },
        "check": { "$ref": "#/$defs/check" }
      }
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "required": ["all_of"],
          "additionalProperties": false,
          "properties": {
            "all_of": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/leaf" }
            }
          }
        },
        { "$ref": "#/$defs/leaf" }
      ]
    },
    "leaf": {
      "type": "object",
      "required": ["field", "operator"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "field": { "type": "string" },
        "operator": {
          "enum": [
            "exists", "nonempty", "equals", "not_equals", "in", "not_in",
            "matches", "length_between", "count_eq", "count_gte",
            "count_where_eq", "count_where_gte", "ordinal_gte", "gte", "lte"
          ]
        },
        "value": {},
        "when_absent": {
          "description": "Value assumed when the property is missing or null (the Azure default)."
        },
        "order": {
          "description": "ordinal_gte: allowed values, weakest first.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "where": { "$ref": "#/$defs/where" },
        "case_sensitive": { "type": "boolean" },
        "context": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_field" }
        },
        "note": { "type": "string" },
        "evidence_source": { "enum": ["arg", "join", "deep", "arg-join"] }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "enum": ["equals", "not_equals"] } } },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "operator": { "enum": ["in", "not_in"] } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "array" } } }
        },
        {
          "if": { "properties": { "operator": { "const": "matches" } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "string" } } }
        },
        {
          "if": { "properties": { "operator": { "const": "length_between" } } },
          "then": { "required": ["min", "max"] }
        },
        {
          "if": { "properties": { "operator": { "enum": ["count_eq", "count_gte"] } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "integer", "minimum": 0 } } }
        },
        {
          "if": { "properties": { "operator": { "enum": ["count_where_eq", "count_where_gte"] } } },
          "then": { "required": ["value", "where"], "properties": { "value": { "type": "integer", "minimum": 0 } } }
        },
        {
          "if": { "properties": { "operator": { "const": "ordinal_gte" } } },
          "then": { "required": ["value", "order"] }
        },
        {
          "if": { "properties": { "operator": { "enum": ["gte", "lte"] } } },
          "then": { "required": ["value"], "properties": { "value": { "type": ["number", "string"] } } }
        }
      ]
    },
    "where": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["equals"] },
        { "required": ["empty"] },
        { "required": ["matches"] }
      ],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": {},
        "empty": { "type": "boolean" },
        "matches": { "type": "string" }
      }
    },
    "context_field": {
      "type": "object",
      "required": ["label", "field"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 }
      }
    },
    "not_evaluated": {
      "type": "object",
      "required": ["category", "note"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": ["outside_azure", "more_collection", "by_construction", "needs_decision", "deep_collection"]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "example_case": {
      "type": "object",
      "required": ["control_id", "name", "resource", "expected"],
      "properties": {
        "control_id": { "type": "string" },
        "name": { "type": "string" },
        "resource": { "type": "object" },
        "environment": { "$ref": "#/$defs/environment" },
        "expected": {
          "enum": ["pass", "fail", "unknown", "inapplicable"]
        }
      }
    }
  }
}
